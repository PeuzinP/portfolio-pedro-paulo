# Server only. Never prefix these variables with VITE_.
UPSTASH_REDIS_REST_URL=https://YOUR-DATABASE.upstash.io
UPSTASH_REDIS_REST_TOKEN=
# Generate once: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# Keep stable across deploys so the same browser retains the same server hash.
ANALYTICS_SECRET=
# Optional. Defaults: portfolio:production:v1 / portfolio:preview:v1 / portfolio:development:v1
# Use a separate database for development/preview whenever possible.
# ANALYTICS_KEY_PREFIX=portfolio:development:v1
