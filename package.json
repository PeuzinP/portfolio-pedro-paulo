{
  "name": "portfolio-pedro-paulo",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && tsc -p tsconfig.server.json && vite build && node scripts/prerender-seo.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "test:e2e": "playwright test",
    "test:server": "node --experimental-strip-types --test tests/server/*.test.ts",
    "test:redis": "node --env-file-if-exists=.env.local --experimental-strip-types scripts/check-visits-redis.ts",
    "test:deployment": "node scripts/check-visits-deployment.mjs"
  },
  "dependencies": {
    "@fontsource/dm-sans": "^5.2.0",
    "@fontsource/ibm-plex-mono": "^5.2.0",
    "@fontsource/space-grotesk": "^5.2.0",
    "lucide-react": "^0.468.0",
    "motion": "^12.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@playwright/test": "1.51.1",
    "@tailwindcss/vite": "4.1.14",
    "@types/node": "^22.20.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "tailwindcss": "4.1.14",
    "typescript": "~5.7.3",
    "vite": "^6.1.0"
  }
}
