{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [{ "source": "/projetos/:path*", "destination": "/index.html" }],
  "functions": {
    "api/visits.ts": {
      "maxDuration": 10,
      "includeFiles": "{server,shared}/**"
    }
  }
}
